{
  "contract": "0.1.0",
  "tool": {
    "name": "squint",
    "version": "0.2.0",
    "purpose": "Checks an image against what was asked of it."
  },
  "actions": [
    {
      "name": "check",
      "title": "Source fidelity",
      "purpose": "Checks a candidate against its source and prompt.",
      "images": [
        {
          "slot": "candidate",
          "role": "candidate",
          "required": true
        },
        {
          "slot": "source",
          "role": "source",
          "required": true
        }
      ],
      "locations": [
        {
          "slot": "allowed",
          "kinds": [
            "mask",
            "bbox",
            "polygon"
          ],
          "required": false
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "outputs": {
        "images": [],
        "locations": [
          "found"
        ]
      },
      "cost": {
        "may_spend": true,
        "basis": "measured",
        "needs_env": [
          "GEMINI_API_KEY"
        ]
      },
      "duration": {
        "typical_s": 40,
        "max_s": 600
      },
      "renders": [
        {
          "name": "report",
          "command": [
            "squint",
            "report",
            "view",
            "{run.dir}",
            "--port",
            "0"
          ]
        }
      ]
    },
    {
      "name": "estimate",
      "title": "Estimate",
      "purpose": "The worst-case spend of a check and the session budget left.",
      "images": [],
      "locations": [],
      "params_schema": {
        "type": "object"
      },
      "outputs": {
        "images": [],
        "locations": []
      },
      "cost": {
        "may_spend": false,
        "needs_env": []
      },
      "duration": {
        "typical_s": 0,
        "max_s": 1
      },
      "renders": []
    }
  ],
  "vocabulary": {
    "disposition": [
      "violation",
      "allowed",
      "unsure"
    ],
    "confidence": [
      "confident",
      "tentative"
    ],
    "evidence": [
      "source",
      "prompt"
    ],
    "score_kind": []
  },
  "limits": {
    "inline_bytes": 33554432
  },
  "progress_interval_s": 10,
  "resources": [
    "squint://runs",
    "squint://run/{id}/run.json",
    "squint://run/{id}/journal"
  ],
  "x-squint": {
    "rules": "squint rules --json"
  }
}
