{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:table-manners:core:refusal",
  "title": "Refusal data (CONTRACT.md 3.1, 4.4)",
  "description": "The `data` of a JSON-RPC -32602 error the contract names, so a host can tell it from other invalid params.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason",
    "run"
  ],
  "properties": {
    "reason": {
      "enum": [
        "client_run_id_reused",
        "not_ready"
      ]
    },
    "run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:table-manners:core:run-ref"
        }
      ],
      "description": "client_run_id_reused: the earlier request's run, null while it has none (queued, or cancelled before allocation). not_ready: always null."
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:table-manners:core:description#/$defs/requirement"
      },
      "description": "not_ready: the requirements this call needs that are missing or invalid."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "not_ready"
          }
        }
      },
      "then": {
        "required": [
          "requirements"
        ],
        "properties": {
          "run": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "requirements": false
        }
      }
    }
  ]
}
